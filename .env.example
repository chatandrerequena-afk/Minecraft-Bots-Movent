# Copia este archivo a ".env" y ajusta los valores segun tu entorno.

# --- Servidor de Minecraft (tu servidor/entorno de pruebas) ---
MINECRAFT_HOST=127.0.0.1
MINECRAFT_PORT=25565
# Version del protocolo que habla el servidor (deja que mineflayer
# autodetecte con "auto" si no lo sabes con certeza).
MINECRAFT_VERSION=1.20.4
# offline  -> servidor con online-mode=false (recomendado para el prototipo)
# microsoft -> requiere autenticacion real de Microsoft por bot (NO recomendado
#              para 30 bots automatizados; ver README, seccion "Autenticacion")
MINECRAFT_AUTH=offline

# --- Bots ---
BOT_COUNT=30
BOT_PREFIX=Bot_

# --- Formacion por defecto ---
FORMATION_COLUMNS=6
FORMATION_ROWS=5
FORMATION_SPACING=1.5

# --- Bridge Node.js (bridge/bridge.js) <-> Python ---
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
